{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "PixelByte API",
  "colors": {
    "primary": "#18FB6F",
    "light": "#18FB6F",
    "dark": "#10B981"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@pixelbyte.app"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.pixelbyte.app"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction",
              "quickstart",
              "authentication"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/pricing",
              "concepts/errors",
              "concepts/webhooks"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Task Management",
            "pages": [
              "api-reference/jobs/submit",
              "api-reference/jobs/estimate",
              "api-reference/jobs/get-status",
              "api-reference/jobs/list",
              "api-reference/jobs/cancel"
            ]
          },
          {
            "group": "Models",
            "pages": [
              "api-reference/models/list",
              "api-reference/models/get"
            ]
          },
          {
            "group": "Providers",
            "pages": [
              "api-reference/providers/list",
              "api-reference/providers/get-models"
            ]
          },
          {
            "group": "File Uploads",
            "pages": [
              "api-reference/uploads/presign",
              "api-reference/uploads/get-status"
            ]
          },
          {
            "group": "Catalog",
            "pages": [
              "api-reference/catalog/models",
              "api-reference/catalog/model-detail",
              "api-reference/catalog/providers",
              "api-reference/catalog/provider-detail",
              "api-reference/catalog/categories",
              "api-reference/catalog/capability-groups"
            ]
          }
        ]
      },
      {
        "tab": "Video Models",
        "groups": [
          {
            "group": "Google",
            "pages": [
              {
                "group": "Veo 3.1 Fast",
                "pages": [
                  "models/video/google/veo-3-1-fast-text-to-video",
                  "models/video/google/veo-3-1-fast-image-to-video",
                  "models/video/google/veo-3-1-fast-reference-to-video"
                ]
              },
              {
                "group": "Veo 3.1 Quality",
                "pages": [
                  "models/video/google/veo-3-1-quality-text-to-video"
                ]
              }
            ]
          },
          {
            "group": "Alibaba",
            "pages": [
              {
                "group": "Wan 2.2 Super",
                "pages": [
                  "models/video/alibaba/wan-2-2-super-image-to-video"
                ]
              }
            ]
          }
        ]
      },
      {
        "tab": "Image Models",
        "groups": [
          {
            "group": "Google",
            "pages": [
              {
                "group": "Nano Banana",
                "pages": [
                  "models/image/google/nano-banana"
                ]
              },
              {
                "group": "Nano Banana Pro",
                "pages": [
                  "models/image/google/nano-banana-pro"
                ]
              }
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "API Reference",
          "href": "/api-reference/jobs/submit",
          "icon": "code"
        },
        {
          "anchor": "Status",
          "href": "https://status.pixelbyte.app",
          "icon": "signal"
        }
      ]
    }
  },
  "api": {
    "baseUrl": "https://api.pixelbyte.app",
    "mdx": {
      "server": "https://api.pixelbyte.app",
      "auth": {
        "method": "bearer"
      }
    },
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["curl", "python", "javascript"],
      "defaults": "required"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/pixelbyte",
      "github": "https://github.com/pixelbyte"
    }
  }
}